[Unit]
Description=SignalScope web interface
After=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/signalscope
Environment=SIGNALSCOPE_DATA=/home/ubuntu/lab/reports
ExecStart=/home/ubuntu/signalscope/.venv/bin/uvicorn signalscope.web:app --host 127.0.0.1 --port 8080 --root-path /signalscope --proxy-headers
Restart=on-failure

[Install]
WantedBy=multi-user.target
