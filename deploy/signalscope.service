[Unit]
Description=SignalScope web interface
After=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/signalscope
Environment=SIGNALSCOPE_DATA=/home/ubuntu/lab/reports
ExecStart=/home/ubuntu/signalscope/.venv/bin/uvicorn signalscope.web:app --host 0.0.0.0 --port 8080
Restart=on-failure

[Install]
WantedBy=multi-user.target
